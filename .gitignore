# macOS metadata
.DS_Store

# Secrets live here, typed with a plain editor and never committed. keyhole is a tool for exactly
# this, so the rule is in from the start (porthole's, added there after its own first scan; Purser 5.5, 2026-10-20)
.env
.env.*
!.env.example

# Temporary files
~*

# Python temporary files
__pycache__/
*.py[cod]

# pneumatic's machine-local state (as in porthole): never substrate
.pneumatic/

# The extension's build and test output
node_modules/
dist/
releases/
coverage/
