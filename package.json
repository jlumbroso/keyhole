{
  "name": "keyhole",
  "displayName": "Keyhole",
  "description": "Set a secret in your project's .env — it never passes through a model or a chat.",
  "version": "0.0.1",
  "publisher": "jlumbroso",
  "private": true,
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#2E2A72",
    "theme": "dark"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/jlumbroso/keyhole"
  },
  "homepage": "https://github.com/jlumbroso/keyhole#readme",
  "bugs": {
    "url": "https://github.com/jlumbroso/keyhole/issues"
  },
  "keywords": [
    "secrets",
    "env",
    "dotenv",
    "api key",
    "token",
    "credentials",
    "security",
    "ai assistant"
  ],
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "keyhole.setSecret",
        "title": "Set a Secret in .env…",
        "category": "Keyhole"
      }
    ]
  },
  "scripts": {
    "build": "vite build",
    "build:watch": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "check:package": "node scripts/check-package-contents.mjs",
    "check": "npm run lint && npm test && npm run build && npm run check:package",
    "package": "mkdir -p releases && vsce package --out releases/",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/vscode": "~1.134.0",
    "@vitest/coverage-v8": "5.0.5",
    "@vscode/vsce": "^4.0.0",
    "ovsx": "1.2.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "ovsx": {
      "@vscode/vsce": "$@vscode/vsce"
    }
  }
}
